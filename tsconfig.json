{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "declarationMap": true,
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "removeComments": true,
        "noLib": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2022",
        "useDefineForClassFields": false,
        "sourceMap": true,
        "allowJs": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": ["node", "jest"],
        "lib": ["es2022"],
        "strict": false,
        "strictNullChecks": true
    }
}
