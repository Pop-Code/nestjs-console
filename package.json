{
    "name": "nestjs-console",
    "version": "12.0.0",
    "description": "A NestJS module that provide a cli",
    "keywords": [
        "nestjs",
        "module",
        "cli",
        "console",
        "commander",
        "terminal"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.tsbuildinfo",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pop-Code/nestjs-console.git"
    },
    "author": "Rmannn <alex.hermann@pop-code.com>",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
        "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0"
    },
    "dependencies": {
        "commander": "^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/common": "12.5.0",
        "@nestjs/core": "12.5.0",
        "@nestjs/platform-express": "12.5.0",
        "@nestjs/testing": "12.5.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "eslint": "10.15.0",
        "jest": "30.5.2",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.15",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    },
    "scripts": {
        "build": "rm -Rf ./dist && tsc -b tsconfig.build.json",
        "doc": "rm -Rf ./docs && typedoc && touch ./docs/.nojekyll",
        "console": "npm run -s build:examples && node .examples/test/console.js",
        "console:debug": "npm run -s build:examples && node --inspect-brk .examples/test/console.js",
        "console:decorators": "npm run -s build:examples && node .examples/test/console.decorators.js",
        "console:decorators:debug": "npm run -s build:examples && node --inspect-brk .examples/test/console.decorators.js",
        "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
        "lint": "eslint ./src/**/*.ts",
        "format": "prettier \"**/*.ts\" --ignore-path ./.prettierignore --write && git status",
        "test:smoke": "node test/smoke.mjs && npm run -s build:examples && node .examples/test/console.js command smoke && node .examples/test/console.decorators.js asyncCommand smoke",
        "prepublishOnly": "npm run build",
        "build:examples": "rm -Rf ./.examples && tsc -p tsconfig.examples.json"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".spec.ts$",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "setupFiles": [
            "./test/setup-jest.mjs"
        ],
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts}",
            "!src/index.ts",
            "!**/test/**"
        ],
        "coverageDirectory": "./coverage"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
