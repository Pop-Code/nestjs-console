{
    "name": "nestjs-console",
    "version": "11.0.0",
    "description": "A NestJS module that provide a cli",
    "keywords": [
        "nestjs",
        "module",
        "cli",
        "console",
        "commander",
        "terminal"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "!dist/**/*.tsbuildinfo",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pop-Code/nestjs-console.git"
    },
    "author": "Rmannn <alex.hermann@pop-code.com>",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
        "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0"
    },
    "dependencies": {
        "commander": "^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/common": "12.5.0",
        "@nestjs/core": "12.5.0",
        "@nestjs/platform-express": "12.5.0",
        "@nestjs/testing": "12.5.0",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "eslint": "10.15.0",
        "jest": "30.5.2",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2"
    },
    "scripts": {
        "build": "rm -Rf ./dist && tsc -b tsconfig.build.json",
        "doc": "rm -Rf ./docs && typedoc && touch ./docs/.nojekyll",
        "console": "node -r tsconfig-paths/register -r ts-node/register test/console.ts",
        "console:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register test/console.ts",
        "console:decorators": "node -r tsconfig-paths/register -r ts-node/register test/console.decorators.ts",
        "console:decorators:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register test/console.decorators.ts",
        "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
        "lint": "eslint ./src/**/*.ts",
        "format": "prettier \"**/*.ts\" --ignore-path ./.prettierignore --write && git status",
        "test:smoke": "node -e \"require('./dist')\" && node -r ts-node/register test/console.ts command smoke && node -r ts-node/register test/console.decorators.ts asyncCommand smoke",
        "prepublishOnly": "npm run build"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts}",
            "!src/index.ts",
            "!**/test/**"
        ],
        "coverageDirectory": "./coverage"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
